{
  "name": "onvif-local",
  "version": "0.1.0",
  "private": true,
  "description": "Gerenciador de câmeras ONVIF para redes locais",
  "desktopName": "br.local.onvif",
  "author": "Heverton Coneglian de Freitas",
  "homepage": "https://github.com/hevertonfreitas/local-onvif",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test:camera": "node scripts/probe-camera.js",
    "build:ffmpeg": "bash scripts/build-ffmpeg.sh",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "26.18.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
